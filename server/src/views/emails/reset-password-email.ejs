<!DOCTYPE html>
<html
  lang="en"
  style="
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background-color: #f9f9f9;
    margin: 0;
    padding: 0;
  "
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset</title>
    <style>
      .container {
        max-width: 600px;
        background: #ffffff;
        margin: 40px auto;
        padding: 30px 40px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      }
      h1 {
        color: #222;
        font-size: 22px;
        margin-bottom: 10px;
      }
      p {
        color: #555;
        line-height: 1.6;
      }
      a.button {
        display: inline-block;
        padding: 12px 24px;
        margin-top: 20px;
        background-color: #007bff;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: background-color 0.2s ease-in-out;
      }
      a.button:hover {
        background-color: #0056b3;
      }
      .footer {
        margin-top: 40px;
        font-size: 13px;
        color: #999;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Hello <%= username %>,</h1>
      <p>
        We received a request to reset your password. You can create a new
        password by clicking the button below:
      </p>

      <a href="<%= link %>" class="button">Reset Your Password</a>

      <p>
        This link will expire in <strong>10 minutes</strong>. If you didn’t
        request a password reset, please ignore this message — your account
        remains secure.
      </p>

      <p>Best regards,<br /><strong>The Support Team</strong></p>

      <div class="footer">
        <p>
          © <%= new Date().getFullYear() %> YourApp. All rights reserved.<br />
          This is an automated message, please do not reply.
        </p>
      </div>
    </div>
  </body>
</html>
